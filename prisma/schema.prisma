// ==========================
//   SCHEMA DE BASE DE DONNÉES
// ==========================
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// ==========================
//        UTILISATEUR
// ==========================
model User {
  id       String @id @default(uuid())
  name     String
  contact  String
  email    String @unique
  password String
  role     Role

  // Relations
  notifs Notif[]
  events Even[]  @relation("UserEvents")
  posts  Post[]
  auditLogs AuditLog[]
  recordedPayments EvenPayment[] @relation("PaymentRecorder")
}

enum Role {
  ADMIN
  AGENT
  FINANCIER
  EDITEUR
  ASSISTANT
}

model Post {
  id          String   @id @default(uuid())
  titre       String
  contenu     String?
  type        String   // 'PUB' ou 'ACTU'
  mediaUrl    String?  // Pour les images ou vidéos
  isPromoted  Boolean  @default(false)
  createdAt   DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
}

// ==========================
//        SALLE
// ==========================
model Salle {
  id           String  @id @default(uuid())
  nom_salle    String
  nombre_place Int?
  visible      Boolean @default(false)
  image        String?

  events     Even[]
  commodites SalleCommodite[]
}

model Commodite {
  id     Int              @id @default(autoincrement())
  nom    String
  salles SalleCommodite[]
}

model SalleCommodite {
  salle   Salle  @relation(fields: [salleId], references: [id])
  salleId String

  commodite   Commodite @relation(fields: [commoditeId], references: [id])
  commoditeId Int

  @@id([salleId, commoditeId])
}

// ==========================
//        EVENEMENT
// ==========================
model Even {
  id             String   @id @default(uuid())
  nom_evenement  String?
  categorie      String
  montant        Float?
  avance         Float?
  date_debut     DateTime
  date_fin       DateTime
  description    String?
  nom_client     String?
  contact_client String?
  type           String?
  visible        Boolean  @default(false)
  organise_par_ccjab Boolean @default(false)
  fiche          String?
  image          String?
  createdAt      DateTime @default(now())

  // salle_id String?
  // salle    Salle?  @relation(fields: [salle_id], references: [id])
  salles         Salle[]

  agent_id String?
  agent    User?   @relation("UserEvents", fields: [agent_id], references: [id])
  payments EvenPayment[]
  ticketTypes TicketType[]
  ticketOrders TicketOrder[]
  @@index([date_debut])
  @@index([agent_id, date_debut])
}

model EvenPayment {
  id               String   @id @default(uuid())
  eventId          String
  amount           Float
  paidAt           DateTime
  method           String?
  reference        String?
  note             String?
  isInitialAdvance Boolean  @default(false)
  isLegacyEstimate Boolean  @default(false)
  createdAt        DateTime @default(now())
  createdById      String?

  event     Even  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PaymentRecorder", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventId, paidAt])
  @@index([paidAt])
}

// ==========================
//       BILLETTERIE
// ==========================
model TicketType {
  id          String   @id @default(uuid())
  eventId     String
  name        String
  description String?
  price       Int
  capacity    Int
  salesStart  DateTime?
  salesEnd    DateTime?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Even @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items TicketOrderItem[]

  @@unique([eventId, name])
  @@index([eventId, isActive])
}

model TicketOrder {
  id                  String            @id @default(uuid())
  reference           String            @unique @default(uuid())
  eventId             String
  customerName        String
  customerEmail       String
  customerPhone       String?
  status              TicketOrderStatus @default(PENDING)
  paymentProvider     TicketPaymentProvider @default(NONE)
  totalAmount         Int
  currency            String            @default("XOF")
  expiresAt           DateTime
  paidAt              DateTime?
  waveCheckoutSessionId String?          @unique
  waveTransactionId   String?            @unique
  geniusPayReference  String?            @unique
  ticketEmailStatus   TicketEmailStatus  @default(PENDING)
  ticketEmailSentAt   DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  event Even @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items TicketOrderItem[]

  @@index([eventId, status, expiresAt])
  @@index([customerEmail, createdAt])
}

model TicketOrderItem {
  id           String @id @default(uuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  unitPrice    Int

  order      TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  tickets    Ticket[]

  @@index([ticketTypeId])
}

model Ticket {
  id          String       @id @default(uuid())
  orderItemId String
  code        String       @unique @default(uuid())
  status      TicketStatus @default(VALID)
  scannedAt   DateTime?
  createdAt   DateTime     @default(now())

  orderItem TicketOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId, status])
}

model GeniusPayWebhookEvent {
  id          String   @id
  event       String
  receivedAt  DateTime @default(now())
  processedAt DateTime?
}

enum TicketOrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
  REFUND_REQUIRED
}

enum TicketPaymentProvider {
  NONE
  WAVE
  GENIUSPAY
}

enum TicketEmailStatus {
  PENDING
  SENDING
  SENT
}

enum TicketStatus {
  VALID
  SCANNED
  VOID
}

// ==========================
//        NOTIFICATIONS
// ==========================
model Notif {
  id         String   @id @default(uuid())
  message    String
  created_at DateTime @default(now())
  isRead     Boolean  @default(false)

  agent_id String
  agent    User   @relation(fields: [agent_id], references: [id])
}

// ==========================
//       JOURNAL D'AUDIT
// ==========================
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String
  actorEmail String
  actorRole  Role
  action     String
  entity     String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entity, createdAt])
}
